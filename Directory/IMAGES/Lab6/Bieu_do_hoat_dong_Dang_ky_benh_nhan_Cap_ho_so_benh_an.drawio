<mxfile host="app.diagrams.net"><diagram id="act" name="Đăng ký bệnh nhân"><mxGraphModel dx="1000" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình: Biểu đồ hoạt động của chức năng Đăng ký bệnh nhân – Cấp hồ sơ bệnh án" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="24" width="775" height="30" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="272" y="78" width="28" height="28" as="geometry"/></mxCell><mxCell id="a1" value="Nhập thông tin phiếu đăng ký: họ tên, địa chỉ,&lt;br&gt;ngày sinh, điện thoại, ảnh 3x4" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#8B1A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="136" y="150" width="300" height="49" as="geometry"/></mxCell><mxCell id="a2" value="Nhập số tiền lệ phí hằng năm" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#8B1A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="232" width="213" height="48" as="geometry"/></mxCell><mxCell id="a3" value="Nhấn &quot;Lập phiếu&quot;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#8B1A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="212" y="312" width="149" height="48" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;html=1;fillColor=#FFFACD;strokeColor=#8B1A3A;" vertex="1" parent="1"><mxGeometry x="247" y="392" width="78" height="54" as="geometry"/></mxCell><mxCell id="a4" value="Kiểm tra bệnh nhân đã có hồ sơ chưa" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#8B1A3A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="158" y="489" width