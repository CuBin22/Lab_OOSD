<mxfile host="app.diagrams.net"><diagram name="Tuyển dụng - Thử việc" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="363" y="29" width="24" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Nhập thông tin ứng viên trúng tuyển:&lt;br&gt;họ tên, CCCD, phòng ban, vị trí" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#A80036;strokeWidth=1.5;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="237" y="105" width="276" height="46" as="geometry"/></mxCell><mxCell id="c4" value="Lập quyết định tuyển dụng: thời gian thử việc,&lt;br&gt;lương thử việc, điều khoản hai bên" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#A80036;strokeWidth=1.5;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="237" y="193" width="276" height="46" as="geometry"/></mxCell><mxCell id="c5" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#A80036;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="308" y="271" width="134" height="64" as="geometry"/></mxCell><mxCell id="c6" value="Hủy giao dịch (rollback),&lt;br&gt;thông báo nguyên nhân từ chối" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#A80036;strokeWidth=1.5;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="627" y="278" width="190" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Giám đốc xem xét, ký duyệt&lt;br&gt;quyết định tuyển dụng" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#A80036;strokeWidth=1.5;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent=