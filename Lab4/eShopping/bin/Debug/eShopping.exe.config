<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<add name="eShoppingDB"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=eShoppingDB;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Để trống SmtpHost: email xác nhận được ghi ra thư mục "Emails" cạnh file .exe (chế độ lab). -->
		<add key="SmtpHost" value="" />
		<add key="SmtpPort" value="587" />
		<add key="SmtpSsl" value="true" />
		<add key="SmtpFrom" value="no-reply@cuahangabc.vn" />
		<add key="SmtpUser" value="" />
		<add key="SmtpPassword" value="" />
	</appSettings>
</configuration>